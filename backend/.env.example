# Environment Configuration
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://paymesh:paymesh_secret@localhost:5432/paymesh_db"

# Redis
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Chaos defaults (can be toggled via admin API)
DEFAULT_FAILURE_RATE=0.1
DEFAULT_LATENCY_MS=100
